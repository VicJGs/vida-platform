{
  "name": "@vida/monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:app": "turbo run dev --filter='!@vida/server'",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "check": "node .claude/hooks/guardrail.mjs --scan && pnpm format:check && pnpm check:one-way-door && pnpm check:types-derived && pnpm check:boundaries && pnpm check:rules && turbo run lint typecheck test e2e --continue",
    "check:fast": "node .claude/hooks/guardrail.mjs --scan && pnpm format:check && pnpm check:one-way-door && pnpm check:rules && pnpm check:docs --base origin/main",
    "check:tier": "node tools/checks/core/changed.mjs --base origin/main",
    "preview:tokens": "node tools/scripts/render-token-preview.mjs",
    "storybook": "pnpm --filter @vida/ui storybook",
    "clean": "turbo run clean && rm -rf node_modules",
    "docs:index": "node tools/checks/core/docs-index.mjs",
    "docs:intent": "node tools/checks/core/intent-units.mjs",
    "docs:inventory": "node tools/scripts/doc-inventory.ts",
    "check:docs": "node tools/checks/core/docs.mjs",
    "check:rules": "node tools/checks/core/rules.mjs",
    "check:one-way-door": "node tools/checks/core/one-way-door.mjs",
    "check:entity-live": "node tools/checks/ts/entity-live.mjs",
    "check:types-derived": "node tools/checks/ts/types-derived.mjs",
    "check:boundaries": "node tools/checks/ts/boundaries.mjs",
    "check:no-stub-nav": "node tools/checks/ts/no-stub-nav.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@swc/core": "^1.16.20",
    "dependency-cruiser": "^18.7.0",
    "prettier": "^3.5.0",
    "turbo": "^2.5.0",
    "typescript-eslint": "^8.33.0"
  },
  "checks": {
    "ruleId": "BR-(?:[A-Z]+-)?(?:[SE]\\d+-)?\\d+[a-z]?",
    "intentId": "(?:HC|PG|GM|RT|BK|FN|ED|NF|HN|FL|SK|HT|HB|SS|RL|PR|PJ|PD|NP|KN|CK|TK|JR|FC|MS|ECO|DLV|RV|SPC|VW|TMP|CB|LG|CL|ITG|IN|EG|AX|SH|DSG)-\\d+",
    "intentTests": {
      "finance": [
        "packages/core/src/services/finance"
      ],
      "notes": [
        "packages/core/src/services/notes",
        "apps/web/src/notes"
      ],
      "preferences": [
        "packages/core/src/services/preferences",
        "apps/web/src/preferences",
        "apps/web/src/settings"
      ],
      "sessions": [
        "packages/core/src/services/sessions",
        "packages/core/src/foundation/sessions",
        "apps/web/src/session-hud",
        "apps/web/src/session-runtime",
        "apps/web/src/flow"
      ],
      "habits": [
        "packages/core/src/services/habits"
      ],
      "tasks": [
        "packages/core/src/services/tasks",
        "apps/web/src/tasks"
      ],
      "routines": [
        "packages/core/src/services/routines"
      ],
      "projects": [
        "packages/core/src/services/projects"
      ],
      "journals": [
        "packages/core/src/services/journals",
        "apps/web/src/home/journal-contribution.test.ts",
        "apps/web/src/home/journal-page-region.test.tsx",
        "apps/web/src/home/use-journal-entry.test.ts",
        "apps/web/src/home/home-surface.test.tsx",
        "apps/web/src/home/section-model.test.ts",
        "apps/web/src/home/section-state.test.ts",
        "apps/web/src/home/selection.test.ts"
      ],
      "relationships": [
        "packages/core/src/services/relationships"
      ],
      "books": [
        "packages/core/src/services/books"
      ],
      "check-ins": [
        "packages/core/src/services/checkins"
      ],
      "purposes": [
        "packages/core/src/services/purposes",
        "packages/core/src/foundation/measurement"
      ],
      "gamification": [
        "packages/core/src/services/gamification",
        "packages/core/src/foundation/economy"
      ],
      "notifications": [
        "packages/core/src/services/notifications",
        "packages/core/src/foundation/notifications"
      ],
      "knowledge": [
        "packages/core/src/services/knowledge",
        "packages/core/src/services/flashcards",
        "packages/core/src/foundation/review"
      ],
      "health": [
        "packages/core/src/db/tests/health-core-introspection.test.ts",
        "packages/core/src/db/tests/health-nutrition-introspection.test.ts",
        "packages/core/src/db/tests/health-training-introspection.test.ts"
      ],
      "learning": [
        "packages/core/src/services/learning-education"
      ],
      "skills": [
        "packages/core/src/db/tests/skills-introspection.test.ts"
      ],
      "spaces": [
        "packages/core/src/foundation/spaces",
        "packages/core/src/foundation/views",
        "packages/core/src/foundation/templates",
        "packages/core/src/foundation/capability"
      ],
      "calendar": [
        "apps/web/src/app/calendar",
        "packages/ui/src/components/agenda-view.test.tsx",
        "packages/ui/src/components/week-view.test.tsx",
        "packages/ui/src/components/year-view.test.tsx",
        "packages/ui/src/components/living-view.test.tsx",
        "packages/ui/src/components/calendar-motion.test.tsx",
        "packages/ui/src/internal/week-layout.test.ts"
      ],
      "integrations": [
        "packages/core/src/foundation/ingestion",
        "packages/core/src/foundation/egress"
      ],
      "ai": [
        "packages/core/src/foundation/ai"
      ],
      "shell": [
        "apps/web/src/shell",
        "apps/web/src/nav",
        "apps/web/src/command-bar",
        "packages/ui/src/themes",
        "packages/ui/src/theme-resolution.test.ts"
      ]
    },
    "intentFeatures": {
      "notes": "notes-and-pages",
      "purposes": "purposes-and-goals",
      "sessions": [
        "sessions-and-scheduling",
        "pomodoro"
      ]
    },
    "adrDirs": [
      "docs/core/decisions",
      ".adr"
    ],
    "src": "packages",
    "e2e": "apps/web/e2e",
    "compositionRoot": "apps/web/src/db/composition-root.ts",
    "routes": "apps/web/src/routes.tsx",
    "navigation": "apps/web/src/nav/module-map.ts",
    "schema": "packages/core/src/db/schema",
    "boundaries": [
      {
        "name": "types-is-leaf",
        "from": "^packages/types/",
        "to": "^(packages/(core|editor|ui)|apps)/"
      },
      {
        "name": "ui-not-core",
        "from": "^packages/ui/",
        "to": "^packages/core/"
      },
      {
        "name": "ui-not-editor",
        "from": "^packages/ui/",
        "to": "^packages/editor/"
      },
      {
        "name": "editor-not-core",
        "from": "^packages/editor/",
        "to": "^packages/core/"
      },
      {
        "name": "legacy-quarantine",
        "from": "^packages/(?!core/src/db/_legacy/)",
        "to": "^packages/core/src/db/_legacy/"
      },
      {
        "name": "core-not-apps",
        "from": "^packages/core/",
        "to": "^apps/"
      }
    ],
    "oneWayDoor": [
      "packages/core/src/db/schema/",
      "packages/core/src/db/migrations/",
      "packages/core/src/encryption/",
      "packages/core/src/sync/"
    ],
    "archiveAllow": [
      {
        "path": "packages/core/src/db/migrations/",
        "why": "merged migrations are never edited (LIF-367)"
      },
      {
        "path": "packages/ui/CHANGELOG.md",
        "why": "historical record, kept as written (LIF-367)"
      },
      {
        "path": "tools/backend-intent/",
        "why": "one-off generators that read archived specs and fail loudly without them (LIF-365)"
      },
      {
        "path": "Old/",
        "why": "quarantined reference-only code (.claude/rules/golden-rules.md)"
      },
      {
        "path": ".prettierignore",
        "why": "keeps Prettier off the docs archive folder"
      },
      {
        "path": ".gitignore",
        "why": "ignores a local tracker file in the agent archive"
      },
      {
        "path": "tools/checks/core/",
        "why": "the checks copied from the toolkit; they name the archive folders they skip and guard"
      }
    ]
  }
}
