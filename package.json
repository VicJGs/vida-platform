{
  "name": "@vida/monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:app": "turbo run dev --filter='!@vida/server'",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "check": "node .claude/hooks/guardrail.mjs --scan && pnpm format:check && pnpm check:rules && pnpm check:one-way-door && turbo run lint typecheck test e2e --continue",
    "check:frontend-source-model": "node tools/scripts/check-frontend-source-model.mjs",
    "preview:tokens": "node tools/scripts/render-token-preview.mjs",
    "storybook": "pnpm --filter @vida/ui storybook",
    "clean": "turbo run clean && rm -rf node_modules",
    "docs:index": "node tools/checks/core/docs-index.mjs",
    "check:docs": "node tools/checks/core/docs.mjs",
    "check:rules": "node tools/checks/core/rules.mjs",
    "check:one-way-door": "node tools/checks/core/one-way-door.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "prettier": "^3.5.0",
    "turbo": "^2.5.0",
    "typescript-eslint": "^8.33.0"
  },
  "checks": {
    "adrDirs": [
      "docs/core/decisions",
      ".adr"
    ]
  }
}
