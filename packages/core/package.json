{
  "name": "@vida/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.8.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.1"
  },
  "dependencies": {
    "@vida/types": "workspace:*",
    "drizzle-orm": "^0.45.1",
    "libsodium-wrappers-sumo": "^0.8.2",
    "secure-remote-password": "^0.3.1"
  }
}
