{
  "name": "@vida/editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.storybook.json",
    "test": "vitest run",
    "storybook": "storybook dev -p 6007 --no-open",
    "build-storybook": "storybook build",
    "clean": "rm -rf dist *.tsbuildinfo storybook-static"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^9",
    "@storybook/react-vite": "^9",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "jsdom": "^30.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "storybook": "^9",
    "typescript": "^5.7.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.1"
  },
  "dependencies": {
    "@tamagui/core": "2.6.2",
    "@tiptap/extension-placeholder": "^3.30.0",
    "@tiptap/pm": "^3.30.0",
    "@tiptap/react": "^3.30.0",
    "@tiptap/starter-kit": "^3.30.0",
    "@vida/types": "workspace:*",
    "@vida/ui": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19"
  }
}
