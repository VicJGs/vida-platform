{
  "name": "@vida/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "tokens:build": "node src/themes/build-tokens.mjs",
    "build": "pnpm tokens:build && tsc --build",
    "dev": "tsc --build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "style-dictionary": "^5.5.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.1"
  },
  "dependencies": {
    "@tamagui/animations-css": "2.6.2",
    "@tamagui/core": "2.6.2"
  },
  "peerDependencies": {
    "react": ">=19"
  }
}
