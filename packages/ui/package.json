{
  "name": "@vida/ui",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "tokens:build": "node src/themes/build-tokens.mjs",
    "build": "pnpm tokens:build && tsc --build",
    "dev": "tsc --build --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.storybook.json",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "clean": "rm -rf dist *.tsbuildinfo storybook-static"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^9",
    "@storybook/react-vite": "^9",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "jsdom": "^30.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "storybook": "^9",
    "style-dictionary": "^5.5.0",
    "typescript": "^5.7.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.1"
  },
  "dependencies": {
    "@tamagui/animations-css": "2.6.2",
    "@tamagui/core": "2.6.2",
    "date-fns": "^4.4.0",
    "graphology": "0.26.0",
    "graphology-layout-forceatlas2": "0.10.1",
    "sigma": "3.0.3"
  },
  "peerDependencies": {
    "react": ">=19"
  }
}
