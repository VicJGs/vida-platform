{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git reset --hard *)",
      "Bash(rm -rf *)"
    ]
  },
  "enabledPlugins": {
    "ts-pack@claude-toolkit": true
  }
}
